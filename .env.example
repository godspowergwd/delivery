# ---------------------------------------------------------------------------
# WAAKYE APP - environment reference
#
# Copy the relevant values into apps/api/.env and apps/web/.env
#
# Business configuration (business name, currency, fees, support phone) and every
# default account live in PostgreSQL - they are NOT environment variables:
#   * default accounts:   apps/api/prisma/seed.ts      (npm run db:seed)
#   * support phone etc.: Admin > Settings             (PATCH /api/settings)
# ---------------------------------------------------------------------------

# --- apps/api/.env ---------------------------------------------------------
# Pooled connection string used by the API at runtime (append ?pgbouncer=true
# when the provider exposes a transaction pooler, as Supabase does).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct, non-pooled connection: used only by Prisma migrations (prisma.config.ts).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=4000
NODE_ENV=development

# Public URL of the API (used for static uploads + QR verification links)
API_PUBLIC_URL="http://localhost:4000"
# Public URL of the web app (used inside QR codes, receipts and the CORS allowlist)
APP_PUBLIC_URL="http://localhost:5173"
# Additional exact frontend origins for credentialed CORS, comma-separated
APP_ALLOWED_ORIGINS=""
# Server-only Mapbox token with Directions API access; never use a VITE_ variable here
MAPBOX_ACCESS_TOKEN=""

# Auth. Only JWT settings live here - never a username, email or password.
JWT_SECRET="change-me-with-a-long-random-string-min-16-chars"
JWT_ACCESS_TTL="12h"

# Number of reverse proxies in front of the API. Render alone = 1 (default).
# Set 2 when Cloudflare (or another CDN) sits in front of Render, otherwise every
# visitor behind the CDN shares one rate-limit bucket.
TRUST_PROXY_HOPS=1

# Development / test only: answer map search, reverse geocoding and directions
# with synthetic data instead of calling Mapbox (used by the load-test harness).
# Ignored completely when NODE_ENV=production.
MAPBOX_MOCK="false"

# Dedicated load-test safety gate. Keep disabled outside an isolated test API.
LOAD_TEST_ENV="disabled"
# Configure only in ignored apps/api/.env with synthetic @loadtest.invalid accounts.
LOAD_TEST_ACCOUNTS_JSON=""

# Cloudflare R2 object storage for uploads
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public URL for R2 bucket (custom domain or r2.dev subdomain)
R2_PUBLIC_URL="https://uploads.example.com"

# Optional local bootstrap only: passwords are required only to create missing seed accounts.
# Keep real values in ignored apps/api/.env, never in this example file.
SEED_ADMIN_PASSWORD=""
SEED_CASHIER_PASSWORD=""
SEED_INVENTORY_PASSWORD=""
SEED_KITCHEN_PASSWORD=""
SEED_DRIVER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# Optional: bcrypt work factor for new password hashes (default 10).
# BCRYPT_ROUNDS="10"

# --- apps/web/.env ---------------------------------------------------------
VITE_API_URL="http://localhost:4000/api"
VITE_SOCKET_URL="http://localhost:4000"
VITE_APP_NAME="Waakye App"

# Optional: Mapbox access token. When present the location autocomplete uses
# the Mapbox Geocoding API first; without it the app uses the built-in
# Mallam/Accra landmark dataset plus the keyless Nominatim proxy, and the
# maps keep rendering on keyless OpenFreeMap tiles through MapLibre GL.
# VITE_MAPBOX_TOKEN="pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
