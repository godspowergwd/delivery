# ---------------------------------------------------------------------------
# WAAKYE APP - environment reference
#
# Copy the relevant values into apps/api/.env and apps/web/.env
#
# Business configuration (business name, currency, fees, support phone) and every
# default account live in PostgreSQL - they are NOT environment variables:
#   * default accounts:   apps/api/prisma/seed.ts      (npm run db:seed)
#   * support phone etc.: Admin > Settings             (PATCH /api/settings)
# ---------------------------------------------------------------------------

# --- apps/api/.env ---------------------------------------------------------
# Pooled connection string used by the API at runtime (append ?pgbouncer=true
# when the provider exposes a transaction pooler, as Supabase does).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct, non-pooled connection: used only by Prisma migrations (prisma.config.ts).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=4000
NODE_ENV=development

# Public URL of the API (used for static uploads + QR verification links)
API_PUBLIC_URL="http://localhost:4000"
# Public URL of the web app (used inside QR codes, receipts and the CORS allowlist)
APP_PUBLIC_URL="http://localhost:5173"

# Auth. Only JWT settings live here - never a username, email or password.
JWT_SECRET="change-me-with-a-long-random-string-min-16-chars"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="30d"
JWT_REMEMBER_TTL="90d"

# Optional: bcrypt work factor for new password hashes (default 10).
# BCRYPT_ROUNDS="10"

# --- apps/web/.env ---------------------------------------------------------
VITE_API_URL="http://localhost:4000/api"
VITE_SOCKET_URL="http://localhost:4000"
VITE_APP_NAME="Waakye App"
