# ---------------------------------------------------------------------------
# DELIVERY SYSTEM - environment reference
# Copy the relevant values into apps/api/.env and apps/web/.env
# ---------------------------------------------------------------------------

# --- apps/api/.env ---------------------------------------------------------
# Any PostgreSQL instance works (managed cloud database or the project-local
# cluster created by `npm run db:up`).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/delivery_system?schema=public"
PORT=4000
NODE_ENV=development

# Public URL of the API (used for static uploads + QR verification links)
API_PUBLIC_URL="http://localhost:4000"
# Public URL of the web app (used inside QR codes and receipts)
APP_PUBLIC_URL="http://localhost:5173"

# Auth
JWT_SECRET="change-me-with-a-long-random-string"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="30d"
JWT_REMEMBER_TTL="90d"

# Business defaults (also editable at runtime from Admin > Settings)
BUSINESS_NAME="Delivery System"
CURRENCY_CODE="GHS"
CURRENCY_SYMBOL="GH₵"
DELIVERY_FEE="8.00"
TAX_RATE="2.5"
MIN_ORDER_TOTAL="10.00"
SUPPORT_PHONE="+233000000000"
SUPPORT_EMAIL="support@deliverysystem.app"

# Seed credentials for the bootstrap accounts
SEED_ADMIN_EMAIL="admin@deliverysystem.app"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_KITCHEN_EMAIL="kitchen@deliverysystem.app"
SEED_KITCHEN_PASSWORD="Kitchen@12345"
SEED_CUSTOMER_EMAIL="customer@deliverysystem.app"
SEED_CUSTOMER_PASSWORD="Customer@12345"

# --- apps/web/.env ---------------------------------------------------------
VITE_API_URL="http://localhost:4000/api"
VITE_SOCKET_URL="http://localhost:4000"