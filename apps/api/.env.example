# Local development environment reference for apps/api
DATABASE_URL="postgresql://user:password@localhost:5432/delivery?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/delivery"
PORT=4000
NODE_ENV=development
LOAD_TEST_ENV=disabled

API_PUBLIC_URL="http://localhost:4000"
APP_PUBLIC_URL="http://localhost:5173"
APP_ALLOWED_ORIGINS=""

# Server-only Mapbox token with Directions API access
MAPBOX_ACCESS_TOKEN=""
MAPBOX_MOCK=false

# Configure only in ignored apps/api/.env for a dedicated isolated load test.
LOAD_TEST_ACCOUNTS_JSON=""

# Auth settings
JWT_SECRET="dev-only-secret-min-16-chars-random-string"
JWT_ACCESS_TTL="12h"

# Cloudflare R2 object storage for uploads
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Only required when creating missing local seed accounts. Existing accounts are never changed.
# Set these only in ignored apps/api/.env; never commit actual values.
SEED_ADMIN_PASSWORD=""
SEED_CASHIER_PASSWORD=""
SEED_INVENTORY_PASSWORD=""
SEED_KITCHEN_PASSWORD=""
SEED_DRIVER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
